    {
      "image": 6,
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/c1f0f12e-2826-487d-b806-c3b0cd85891d.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/c1f0f12e-2826-487d-b806-c3b0cd85891d/full/2000,/0/default.jpg",
      "label": "[6]",
      "file": "06.jpg",
